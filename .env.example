# Use a Hugging Face model ID, e.g. Qwen/Qwen3-8B, or a mounted path, e.g. /models/my-model.
MODEL=Qwen/Qwen3-0.6B
SERVED_MODEL_NAME=assistant
TENSOR_PARALLEL_SIZE=1

# For local model files: set MODEL_DIR to the host folder and MODEL to /models/<folder>.
MODEL_DIR=./models
HF_TOKEN=

# Optional key required from clients by the Rust gateway. Keep it private.
API_KEY=

# Optional external port and vLLM image override.
PORT=8080
VLLM_IMAGE=vllm/vllm-openai:latest
